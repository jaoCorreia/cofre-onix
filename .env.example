# Copie para .env e preencha. O .env não vai para o git.

# --- App (vai para o bundle: só valores PÚBLICOS) ---
# Painel do Supabase > Project Settings > API
SUPABASE_URL=https://ukjmrbvdntsvekpljjqb.supabase.co
# Chave publishable/anon. NUNCA coloque a service_role aqui.
SUPABASE_ANON_KEY=
# Google Cloud Console > Credenciais > ID do cliente OAuth (tipo "Aplicativo da Web")
GOOGLE_WEB_CLIENT_ID=

# --- Servidor (Supabase Edge Functions: `supabase secrets set --env-file .env`) ---
# Nunca é lida pelo app; fica só no backend.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Android (Google Cloud > Credenciais > ID do cliente OAuth tipo "Android") ---
# Não vai para o bundle: o app usa o ID Web acima. Fica aqui como referência.
ANDROID_PACKAGE_NAME=
GOOGLE_ANDROID_CLIENT_ID=
# Caminho do JSON baixado do Google Cloud (a pasta secrets/ não vai para o git)
GOOGLE_ANDROID_CLIENT_JSON=secrets/google-android-client.json
# SHA-1 da chave de depuração (~/.android/debug.keystore)
ANDROID_DEBUG_SHA1=9A:BD:21:FA:B4:49:38:8C:C2:EE:6D:74:21:AC:44:69:72:04:3F:AC
